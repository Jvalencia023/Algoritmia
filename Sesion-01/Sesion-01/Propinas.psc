Algoritmo Propinas
	Escribir "Digite la cuenta"
	Leer cuenta
	Escribir "y su porcentaje"
	leer porcentaje
	Escribir "Ahora el numero de personas"
	leer personas
	propina <- cuenta * porcentaje / 100
	total <- cuenta + propina
	Porpersona <- total / personas
	Escribir "Cada uno paga: $", Porpersona
	
FinAlgoritmo
